# ══ PowerI 环境配置 ══════════════════════════════════════
# 复制本文件为 `.env` 并填写真实值。
# 真实 `.env` 已被 .gitignore 忽略，绝不提交。本文件只放占位符，提交进仓库。
# 校验：npm run validate:env

# ── 模型凭据（至少设置一个）──────────────────────────────
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# 自定义 provider 见 ~/.pi/agent/models.json（apiKey 支持 $ENV_VAR 插值）

# ── pi 运行时 ────────────────────────────────────────────
PI_OFFLINE=1                # 关闭启动外呼（版本检查 / telemetry / pi.dev）
# PI_CODING_AGENT_SESSION_DIR=/data/sessions   # 会话存储目录（如需与工作区分开）

# ── PowerI 平台 ─────────────────────────────────────────
POWERI_GATEWAY_PORT=8080    # 网关监听端口
POWERI_BRIDGE_PORT=8081     # 桥（stdio↔WS）监听端口
POWERI_WORKSPACE=./workspace  # 默认工作区（本地 PoC 用）
