# ══ PowerI 环境配置 ══════════════════════════════════════
# 复制本文件为 `.env` 并填写真实值。
# 真实 `.env` 已被 .gitignore 忽略，绝不提交。本文件只放占位符，提交进仓库。
# 校验：npm run validate:env

# ── 模型凭据 ────────────────────────────────────────────
# 主路径：使用自建 AI 网关（下方 POWERI_AI_* 必填）。
# 备选：仅当你不用网关、直接走 pi 内置 provider 时才需要以下 key：
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# 自定义 provider 见 ~/.pi/agent/models.json（apiKey 支持 $ENV_VAR 插值）

# ── pi 运行时 ────────────────────────────────────────────
PI_OFFLINE=1                # 关闭启动外呼（版本检查 / telemetry / pi.dev）
# PI_CODING_AGENT_SESSION_DIR=/data/sessions   # 会话存储目录（如需与工作区分开）

# ── 自建 AI 网关（自定义 provider）────────────────────────
# 你自建 AI 网关（OpenAI 兼容）。这些是 PowerI 读取的唯一来源；
# 用 `npm run gen:pi-config` 渲染成 pi 的 models.json / settings.json。
POWERI_AI_BASE_URL=          # 网关 base URL，如 https://gw.example.com/v1
POWERI_AI_API_KEY=           # 网关 key
POWERI_AI_MODEL=             # 模型名（你网关里的模型 id）
POWERI_AI_THINKING=on        # 模型是否支持 extended thinking（on/off）
POWERI_AI_THINKING_LEVEL=medium  # 默认思考等级: off/minimal/low/medium/high/xhigh/max

# ── PowerI 平台 ─────────────────────────────────────────
POWERI_GATEWAY_PORT=8080    # 网关监听端口
POWERI_BRIDGE_PORT=8081     # 桥（stdio↔WS）监听端口
POWERI_WORKSPACE=./workspace  # 默认工作区（本地 PoC 用）
POWERI_GATEWAY_ADMIN_TOKEN=admin-token  # 管理端接口鉴权（计量/出账）
POWERI_PRICES_FILE=         # 定价规则 JSON（覆盖默认价目，见 gateway/pricing.mjs）
