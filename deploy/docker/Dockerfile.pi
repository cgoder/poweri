# PowerI Worker 沙箱镜像：单 Node 运行时
# 容器内只用 Node：pi 本身是 Node，后续 skills/扩展也在 Node 里跑；桥也用 Node（唯一依赖 ws）。
# 构建（上下文=仓库根）：docker build -f deploy/docker/Dockerfile.pi -t pi-sandbox:local .

FROM node:24-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates git ripgrep \
  && rm -rf /var/lib/apt/lists/*

# 锁版本安装 pi（可复现构建）
ARG PI_VERSION=0.83.0
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent@${PI_VERSION}

# 镜像内版本标记（升级验证用；默认空不影响）
ARG BUILD_MARKER=""
RUN echo "poweri-worker ${BUILD_MARKER}" > /etc/poweri-version

# 桥：Node + ws（单运行时原则）
COPY bridge/ /bridge/
RUN cd /bridge && npm install --omit=dev --ignore-scripts

# User Memory 扩展（ticket 08）：打包进镜像，桥以 -e 加载；typebox 从 pi 的 node_modules 解析
COPY memory-extension/user-memory.mjs memory-extension/memory-core.mjs /poweri/extensions/

# 非 root 运行（收窄被注入工具的影响面）
RUN useradd --create-home --shell /bin/bash piuser
USER piuser
ENV HOME=/home/piuser

# 关闭启动外呼（版本检查/telemetry/pi.dev）
ENV PI_OFFLINE=1

WORKDIR /workspace
ENTRYPOINT ["pi"]
