# PowerI pi-web 可视化多用户验证镜像（ticket 15）
# pi-web：pi 的本地 Web UI（Next.js 16，进程内 SDK 驱动 pi）。依赖 pi 系列 0.83.0
#         = 与平台锁定版本完全一致；npm 包内已含 .next 构建产物，无需运行时构建。
# 用法：每测试用户一个实例，挂载该用户 .pi/agent（会话 JSONL + models.json 一体）与 workspace，
#       各自访问各自界面（独立 Basic Auth）→ 多租户隔离 / 真实 pi 并发 / 会话续接的可视化。
# 构建（上下文=仓库根）：docker build -f deploy/docker/Dockerfile.piweb -t poweri-piweb:local .

FROM node:24-bookworm-slim

# 锁版本安装 pi-web（可复现构建；与 worker 镜像同一基底，单 Node 运行时）
ARG PIWEB_VERSION=0.8.6
RUN npm install -g @agegr/pi-web@${PIWEB_VERSION}

# 非 root 运行（每实例独立容器兜底进程内 pi 崩溃）
RUN useradd --create-home --shell /bin/bash piuser
USER piuser
ENV HOME=/home/piuser

# 数据目录指向挂载点：每用户 .pi/agent（pi-web 与 pi 共用同一套配置/会话目录）
ENV PI_CODING_AGENT_DIR=/home/piuser/.pi/agent
# 关闭 pi 启动外呼（版本检查/telemetry/pi.dev）
ENV PI_OFFLINE=1
# 对外监听（容器端口映射需要 0.0.0.0）+ 不自动开浏览器
ENV PI_WEB_HOSTNAME=0.0.0.0
ENV PI_WEB_NO_OPEN=1

WORKDIR /workspace
EXPOSE 30141
ENTRYPOINT ["pi-web"]
