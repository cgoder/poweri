# jmfederico/pi-web 每用户实例镜像（ticket 22 A′ 试点）
# 分裂进程模型：entrypoint 后台起 sessiond（会话守护），前台起 web（Fastify 8504）
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential python3 git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

ARG PI_WEB_VERSION=1.202607.3  # 锁版可复现（ticket 22 实测版本，repo 惯例与 Dockerfile.piweb 一致）
RUN npm install -g --omit=dev --include=peer --no-audit --no-fund "@jmfederico/pi-web@${PI_WEB_VERSION}" --allow-scripts=node-pty \
 && peer_pi_bin="$(npm root -g)/@jmfederico/pi-web/node_modules/.bin/pi"; \
    if [ -x "${peer_pi_bin}" ]; then ln -sf "${peer_pi_bin}" /usr/local/bin/pi; fi \
 && npm cache clean --force

ENV NODE_ENV=production \
  HOME=/data/home \
  XDG_CONFIG_HOME=/data/config \
  PI_WEB_HOST=0.0.0.0 \
  PI_WEB_PORT=8504 \
  PI_WEB_DATA_DIR=/data/pi-web \
  PI_WEB_SESSIOND_SOCKET=/data/pi-web/sessiond.sock \
  PI_CODING_AGENT_DIR=/data/pi-agent

RUN mkdir -p /data/home /data/config /data/pi-web && chown -R node:node /data
COPY --chown=node:node entrypoint-piweb2.sh /usr/local/bin/entrypoint-piweb2.sh
RUN chmod +x /usr/local/bin/entrypoint-piweb2.sh

USER node
EXPOSE 8504
ENTRYPOINT ["entrypoint-piweb2.sh"]
